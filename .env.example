# Copien este archivo como .env si quieren cambiar algo. Son valores de ejemplo,
# no van al repo (el .env real está ignorado por git).
POSTGRES_USER=factura
POSTGRES_PASSWORD=factura
POSTGRES_DB=factura

# La URL que usa la app dentro de Docker: el host es el nombre del servicio "db".
DATABASE_URL=postgresql+psycopg://factura:factura@db:5432/factura

# Gente, clave para el código de verificación de las facturas. Cada quien pone la suya en su .env; NUNCA se sube la real.
FACTURA_HMAC_KEY=cambia_esta_clave

# Gente, clave para llamar a la API (encabezado X-API-Key). Cada quien define la suya; NUNCA se sube la real.
API_KEY=cambia_esta_clave

UI_ORIGIN=http://localhost:8080
BACKEND_URL=http://localhost:8000
